                        	    10: 
                        	    11: lcd_wait:
00:8032 48              	    12:     pha
                        	    13:     ;; set port-B mode to input
00:8033 9C0260          	    14:     stz DDRB
                        	    15:     ;; RS=0, RW=1, E=1
00:8036 AD0160          	    16:     lda PORTA
00:8039 29DF            	    17:     and #(~RS)
00:803B 09C0            	    18:     ora #(RW | E)
00:803D 8D0160          	    19:     sta PORTA
                        	    20: .loopBusy:
                        	    21:     ;; read busy flag
00:8040 AD0060          	    22:     lda PORTB
                        	    23:     ;; test busy bit
00:8043 2980            	    24:     and #$80
00:8045 D0F9            	    25:     bne .loopBusy
                        	    26:     ;; restore port-B mode to output
00:8047 A9FF            	    27:     lda #$ff
00:8049 8D0260          	    28:     sta DDRB
00:804C 68              	    29:     pla
00:804D 60              	    30:     rts
                        	    31: 
                        	    32: lcd_instruction: ; A->()
00:804E 203280          	    33:     jsr lcd_wait
00:8051 8D0060          	    34:     sta PORTB
00:8054 AD0160          	    35:     lda PORTA
                        	    36:     ;; RS=0. RW=0, E=1
00:8057 299F            	    37:     and #(~(RS | RW))
00:8059 0980            	    38:     ora #E
00:805B 8D0160          	    39:     sta PORTA
                        	    40:     ;; trigger E neg-edge
00:805E 4980            	    41:     eor #E
00:8060 8D0160          	    42:     sta PORTA
00:8063 60              	    43:     rts
                        	    44: 
                        	    45: lcd_emitChar: ; A->()
00:8064 203280          	    46:     jsr lcd_wait
00:8067 8D0060          	    47:     sta PORTB
00:806A AD0160          	    48:     lda PORTA
                        	    49:     ;; RS=1, RW=0, E=1
00:806D 29BF            	    50:     and #(~RW)
00:806F 09A0            	    51:     ora #(RS | E)
00:8071 8D0160          	    52:     sta PORTA
                        	    53:     ;; trigger E neg-edge
00:8074 4980            	    54:     eor #E
00:8076 8D0160          	    55:     sta PORTA
00:8079 60              	    56:     rts
