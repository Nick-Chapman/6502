                        	   126: ;;; measure work getting done...
                        	   127: ;;; 'work' is incrementing a counter; reset counter each second
                        	   128: ;;; (main loop) display the time in seconds & the running counter
                        	   129: ;;; explore calling display only every 1/5 second
                        	   130: 
                        	   131: jiffy = 20
                        	   132: jiffy_last_second = 21
                        	   133: jiffy_last_status = 22
                        	   134: 
                        	   135: counter = 23 ;; 3bytes (BCD
                        	   136: seconds = 26 ;; 2bytes (BCD)
                        	   137: 
                        	   138: last_counter = 28 ;; 3bytes
                        	   139: 
                        	   140: reset:
00:80A1 58              	   141:     cli ; enable IRQ
00:80A2 6414            	   142:     stz jiffy
00:80A4 6415            	   143:     stz jiffy_last_second
00:80A6 200080          	   144:     jsr via_init
00:80A9 202280          	   145:     jsr lcd_init
00:80AC 201481          	   146:     jsr reset_counter
00:80AF 201B81          	   147:     jsr reset_last_counter
00:80B2 202281          	   148:     jsr reset_seconds
                        	   149: .loop:
                        	   150:     ;;jsr every_second
