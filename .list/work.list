                        	    29: via_init:
                        	    30:     ;; set all pins on port-B and port-A as output
00:8000 A9FF            	    31:     lda #%11111111
00:8002 8D0260          	    32:     sta DDRB
00:8005 8D0360          	    33:     sta DDRA
00:8008 A900            	    34:     lda #%00000000 ; negative edge on any of CA1,CA2,CB1,CB2
00:800A 8D0C60          	    35:     sta PCR
00:800D A9C3            	    36:     lda #%11000011 ; enable Timer1, CA1 and CA2
00:800F 8D0E60          	    37:     sta IER
                        	    38:     ;; Setup timer1
00:8012 A940            	    39:     lda #%01000000 ; timer-1 in free running mode
00:8014 8D0B60          	    40:     sta ACR
                        	    41:     ;; 4E1E = 19998 (100/s), at 2 MhZ
00:8017 A91E            	    42:     lda #$1e
00:8019 8D0460          	    43:     sta T1CL
00:801C A94E            	    44:     lda #$4e
00:801E 8D0560          	    45:     sta T1CH ;; starts timer
00:8021 60              	    46:     rts
