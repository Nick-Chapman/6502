                        	    48: lcd_init:
00:8022 A938            	    49:     lda #LCD_FunctionSet_8bit_2lines
00:8024 204E80          	    50:     jsr lcd_instruction
00:8027 A90C            	    51:     lda #LCD_DisplayOn_CursorOff
00:8029 204E80          	    52:     jsr lcd_instruction
00:802C A901            	    53:     lda #LCD_ClearDisplay
00:802E 204E80          	    54:     jsr lcd_instruction
00:8031 60              	    55:     rts
                        	    56: 
                        	    57: lcd_wait:
00:8032 48              	    58:     pha
                        	    59:     ;; set port-B mode to input
00:8033 9C0260          	    60:     stz DDRB
                        	    61:     ;; RS=0, RW=1, E=1
00:8036 AD0160          	    62:     lda PORTA
00:8039 29DF            	    63:     and #(~RS)
00:803B 09C0            	    64:     ora #(RW | E)
00:803D 8D0160          	    65:     sta PORTA
                        	    66: .loopBusy:
                        	    67:     ;; read busy flag
00:8040 AD0060          	    68:     lda PORTB
                        	    69:     ;; test busy bit
00:8043 2980            	    70:     and #$80
00:8045 D0F9            	    71:     bne .loopBusy
                        	    72:     ;; restore port-B mode to output
00:8047 A9FF            	    73:     lda #$ff
00:8049 8D0260          	    74:     sta DDRB
00:804C 68              	    75:     pla
00:804D 60              	    76:     rts
                        	    77: 
                        	    78: lcd_instruction: ; A->()
00:804E 203280          	    79:     jsr lcd_wait
00:8051 8D0060          	    80:     sta PORTB
00:8054 AD0160          	    81:     lda PORTA
                        	    82:     ;; RS=0. RW=0, E=1
00:8057 299F            	    83:     and #(~(RS | RW))
00:8059 0980            	    84:     ora #E
00:805B 8D0160          	    85:     sta PORTA
                        	    86:     ;; trigger E neg-edge
00:805E 4980            	    87:     eor #E
00:8060 8D0160          	    88:     sta PORTA
00:8063 60              	    89:     rts
                        	    90: 
