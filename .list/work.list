                        	    82: seconds = 26 ;; 2bytes (BCD)
                        	    83: 
                        	    84: last_counter = 28 ;; 3bytes
                        	    85: 
                        	    86: reset:
00:80A1 58              	    87:     cli ; enable IRQ
00:80A2 6414            	    88:     stz jiffy
00:80A4 6415            	    89:     stz jiffy_last_second
00:80A6 200080          	    90:     jsr via_init
00:80A9 202280          	    91:     jsr lcd_init
00:80AC 201481          	    92:     jsr reset_counter
00:80AF 201B81          	    93:     jsr reset_last_counter
00:80B2 202281          	    94:     jsr reset_seconds
                        	    95: .loop:
                        	    96:     ;;jsr every_second
                        	    97:     ;;jsr update_status_display
