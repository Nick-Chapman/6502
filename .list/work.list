                        	    71: 
                        	    72: ;;; measure work getting done...
                        	    73: ;;; 'work' is incrementing a counter; reset counter each second
                        	    74: ;;; (main loop) display the time in seconds & the running counter
                        	    75: ;;; explore calling display only every 1/5 second
                        	    76: 
                        	    77: jiffy = 20
                        	    78: jiffy_last_second = 21
                        	    79: jiffy_last_status = 22
                        	    80: 
