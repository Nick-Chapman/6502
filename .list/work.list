00:8067 8D0060          	    93:     sta PORTB
00:806A AD0160          	    94:     lda PORTA
                        	    95:     ;; RS=1, RW=0, E=1
00:806D 29BF            	    96:     and #(~RW)
00:806F 09A0            	    97:     ora #(RS | E)
00:8071 8D0160          	    98:     sta PORTA
                        	    99:     ;; trigger E neg-edge
00:8074 4980            	   100:     eor #E
00:8076 8D0160          	   101:     sta PORTA
00:8079 60              	   102:     rts
