Source: "lcd.s"
                        	     1: 
                        	     2: lcd_init:
                        	     3:     ;; set all pins on port-B as output
00:8000 A9FF            	     4:     lda #%11111111
00:8002 8D0260          	     5:     sta DDRB
                        	     6:     ;; set most significant 3 pins on port-A as output
00:8005 A9E0            	     7:     lda #%11100000
00:8007 8D0360          	     8:     sta DDRA
00:800A A938            	     9:     lda #LCD_FunctionSet_8bit_2lines
00:800C 203A80          	    10:     jsr lcd_instruction
00:800F A90E            	    11:     lda #LCD_DisplayOn_CursorOn_NoBlink
00:8011 203A80          	    12:     jsr lcd_instruction
                        	    13:     ;;lda #LCD_ReturnHome
00:8014 A901            	    14:     lda #LCD_ClearDisplay
00:8016 203A80          	    15:     jsr lcd_instruction
                        	    16: 
                        	    17: lcd_wait:
00:8019 48              	    18:     pha
                        	    19: .loop:
                        	    20:     ;; set port-B mode to input
00:801A 9C0260          	    21:     stz DDRB
                        	    22:     ;; read busy flag
00:801D A940            	    23:     lda #RW
00:801F 8D0160          	    24:     sta PORTA
00:8022 A9C0            	    25:     lda #(RW | E)
00:8024 8D0160          	    26:     sta PORTA
00:8027 AD0060          	    27:     lda PORTB
                        	    28:     ;; test busy bit
00:802A 2980            	    29:     and #$80
00:802C D0EC            	    30:     bne .loop
00:802E A940            	    31:     lda #RW
00:8030 8D0160          	    32:     sta PORTA
                        	    33:     ;; restore port-B mode to output
00:8033 A9FF            	    34:     lda #$ff
00:8035 8D0260          	    35:     sta DDRB
00:8038 68              	    36:     pla
00:8039 60              	    37:     rts
                        	    38: 
                        	    39: lcd_instruction:
00:803A 201980          	    40:     jsr lcd_wait
00:803D 8D0060          	    41:     sta PORTB
00:8040 A900            	    42:     lda #0
00:8042 8D0160          	    43:     sta PORTA
00:8045 A980            	    44:     lda #E
00:8047 8D0160          	    45:     sta PORTA
00:804A A900            	    46:     lda #0
00:804C 8D0160          	    47:     sta PORTA
00:804F 60              	    48:     rts
