00:8020 AD0060          	    22:     lda PORTB
                        	    23:     ;; test busy bit
00:8023 2980            	    24:     and #$80
00:8025 D0EC            	    25:     bne .loop
00:8027 A940            	    26:     lda #RW
00:8029 8D0160          	    27:     sta PORTA
