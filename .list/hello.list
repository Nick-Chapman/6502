                        	     1: 
                        	     2:     org $8000
                        	     3: 
                        	     4: PORTB = $6000
                        	     5: PORTA = $6001
                        	     6: DDRB  = $6002
                        	     7: DDRA  = $6003
                        	     8: 
                        	     9: E  = %10000000 ; enable
                        	    10: RW = %01000000 ; read/write
                        	    11: RS = %00100000 ; register select
                        	    12: 
                        	    13: LCD_ClearDisplay               = %00000001
                        	    14: LCD_ReturnHome                 = %00000010
                        	    15: LCD_EntryMode_Inc_NoShift      = %00000110
                        	    16: LCD_DisplayOn_CursorOff        = %00001100
                        	    17: LCD_DisplayOn_CursorOn_NoBlink = %00001110
                        	    18: LCD_DisplayShift_Left          = %00011000
                        	    19: LCD_FunctionSet_8bit_2lines    = %00111000
                        	    20: 
                        	    21: via_init:
                        	    22:     ;; set all pins on port-B as output
00:8000 A9FF            	    23:     lda #%11111111
00:8002 8D0260          	    24:     sta DDRB
                        	    25:     ;; set most significant 3 pins on port-A as output
00:8005 A9E0            	    26:     lda #%11100000
00:8007 8D0360          	    27:     sta DDRA
00:800A 60              	    28:     rts
                        	    29: 
                        	    30:     include lcd.s

Source: "lcd.s"
                        	     1: 
                        	     2: lcd_init:
00:800B A938            	     3:     lda #LCD_FunctionSet_8bit_2lines
00:800D 203780          	     4:     jsr lcd_instruction
00:8010 A90C            	     5:     lda #LCD_DisplayOn_CursorOff
00:8012 203780          	     6:     jsr lcd_instruction
00:8015 A901            	     7:     lda #LCD_ClearDisplay
00:8017 203780          	     8:     jsr lcd_instruction
00:801A 60              	     9:     rts
                        	    10: 
                        	    11: lcd_wait:
00:801B 48              	    12:     pha
                        	    13:     ;; set port-B mode to input
00:801C 9C0260          	    14:     stz DDRB
                        	    15:     ;; RS=0, RW=1, E=1
00:801F AD0160          	    16:     lda PORTA
00:8022 29DF            	    17:     and #(~RS)
00:8024 09C0            	    18:     ora #(RW | E)
00:8026 8D0160          	    19:     sta PORTA
                        	    20: .loopBusy:
                        	    21:     ;; read busy flag
00:8029 AD0060          	    22:     lda PORTB
                        	    23:     ;; test busy bit
00:802C 2980            	    24:     and #$80
00:802E D0F9            	    25:     bne .loopBusy
                        	    26:     ;; restore port-B mode to output
00:8030 A9FF            	    27:     lda #$ff
00:8032 8D0260          	    28:     sta DDRB
00:8035 68              	    29:     pla
00:8036 60              	    30:     rts
                        	    31: 
                        	    32: lcd_instruction: ; A->()
00:8037 201B80          	    33:     jsr lcd_wait
00:803A 8D0060          	    34:     sta PORTB
00:803D AD0160          	    35:     lda PORTA
                        	    36:     ;; RS=0. RW=0, E=1
00:8040 299F            	    37:     and #(~(RS | RW))
00:8042 0980            	    38:     ora #E
00:8044 8D0160          	    39:     sta PORTA
                        	    40:     ;; trigger E neg-edge
00:8047 4980            	    41:     eor #E
00:8049 8D0160          	    42:     sta PORTA
00:804C 60              	    43:     rts
                        	    44: 
                        	    45: lcd_emitChar: ; A->()
00:804D 201B80          	    46:     jsr lcd_wait
00:8050 8D0060          	    47:     sta PORTB
00:8053 AD0160          	    48:     lda PORTA
                        	    49:     ;; RS=1, RW=0, E=1
00:8056 29BF            	    50:     and #(~RW)
00:8058 09A0            	    51:     ora #(RS | E)
00:805A 8D0160          	    52:     sta PORTA
                        	    53:     ;; trigger E neg-edge
00:805D 4980            	    54:     eor #E
00:805F 8D0160          	    55:     sta PORTA
00:8062 60              	    56:     rts
                        	    57: 

