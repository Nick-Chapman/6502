00:805B A9A0            	    55:     lda #(RS | E)
00:805D 8D0160          	    56:     sta PORTA
00:8060 A920            	    57:     lda #RS
00:8062 8D0160          	    58:     sta PORTA
00:8065 60              	    59:     rts
