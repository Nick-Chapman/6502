00:80B0 38              	   144:     sec
00:80B1 A517            	   145:     lda ACOUNTER
00:80B3 6900            	   146:     adc #0
00:80B5 8517            	   147:     sta ACOUNTER
00:80B7 D010            	   148:     bne .done
00:80B9 38              	   149:     sec
00:80BA A518            	   150:     lda ACOUNTER+1
00:80BC 6900            	   151:     adc #0
00:80BE 8518            	   152:     sta ACOUNTER+1
00:80C0 D007            	   153:     bne .done
00:80C2 38              	   154:     sec
00:80C3 A519            	   155:     lda ACOUNTER+2
00:80C5 6900            	   156:     adc #0
00:80C7 8519            	   157:     sta ACOUNTER+2
                        	   158: .done:
00:80C9 D8              	   159:     cld
00:80CA 60              	   160:     rts
