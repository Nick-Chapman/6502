                        	    36: via_init:
                        	    37:     ;; set all pins on port-B and port-A as output
00:8000 A9FF            	    38:     lda #%11111111
00:8002 8D0260          	    39:     sta DDRB
00:8005 8D0360          	    40:     sta DDRA
00:8008 A900            	    41:     lda #%00000000 ; negative edge on any of CA1,CA2,CB1,CB2
00:800A 8D0C60          	    42:     sta PCR
00:800D A9C3            	    43:     lda #%11000011 ; enable Timer1, CA1 and CA2
00:800F 8D0E60          	    44:     sta IER
                        	    45:     ;; Setup timer1
00:8012 A940            	    46:     lda #%01000000 ; timer-1 in free running mode
00:8014 8D0B60          	    47:     sta ACR
                        	    48:     ;; 4E1E = 19998 (100/s), at 2 MhZ
00:8017 A91E            	    49:     lda #$1e
00:8019 8D0460          	    50:     sta T1CL
00:801C A94E            	    51:     lda #$4e
00:801E 8D0560          	    52:     sta T1CH ;; starts timer
00:8021 60              	    53:     rts
                        	    54: 
                        	    55: lcd_init:
00:8022 A938            	    56:     lda #LCD_FunctionSet_8bit_2lines
00:8024 204E80          	    57:     jsr lcd_instruction
00:8027 A90C            	    58:     lda #LCD_DisplayOn_CursorOff
00:8029 204E80          	    59:     jsr lcd_instruction
00:802C A901            	    60:     lda #LCD_ClearDisplay
00:802E 204E80          	    61:     jsr lcd_instruction
00:8031 60              	    62:     rts
                        	    63: 
                        	    64: lcd_wait:
00:8032 48              	    65:     pha
                        	    66:     ;; set port-B mode to input
00:8033 9C0260          	    67:     stz DDRB
                        	    68:     ;; RS=0, RW=1, E=1
00:8036 AD0160          	    69:     lda PORTA
00:8039 29DF            	    70:     and #(~RS)
00:803B 09C0            	    71:     ora #(RW | E)
00:803D 8D0160          	    72:     sta PORTA
                        	    73: .loopBusy:
                        	    74:     ;; read busy flag
00:8040 AD0060          	    75:     lda PORTB
                        	    76:     ;; test busy bit
00:8043 2980            	    77:     and #$80
00:8045 D0F9            	    78:     bne .loopBusy
                        	    79:     ;; restore port-B mode to output
00:8047 A9FF            	    80:     lda #$ff
00:8049 8D0260          	    81:     sta DDRB
00:804C 68              	    82:     pla
00:804D 60              	    83:     rts
                        	    84: 
                        	    85: lcd_instruction: ; A->()
00:804E 203280          	    86:     jsr lcd_wait
00:8051 8D0060          	    87:     sta PORTB
00:8054 AD0160          	    88:     lda PORTA
                        	    89:     ;; RS=0. RW=0, E=1
00:8057 299F            	    90:     and #(~(RS | RW))
00:8059 0980            	    91:     ora #E
00:805B 8D0160          	    92:     sta PORTA
                        	    93:     ;; trigger E neg-edge
00:805E 4980            	    94:     eor #E
00:8060 8D0160          	    95:     sta PORTA
00:8063 60              	    96:     rts
                        	    97: 
                        	    98: lcd_emitChar: ; A->()
00:8064 203280          	    99:     jsr lcd_wait
00:8067 8D0060          	   100:     sta PORTB
00:806A AD0160          	   101:     lda PORTA
                        	   102:     ;; RS=1, RW=0, E=1
00:806D 29BF            	   103:     and #(~RW)
00:806F 09A0            	   104:     ora #(RS | E)
00:8071 8D0160          	   105:     sta PORTA
                        	   106:     ;; trigger E neg-edge
00:8074 4980            	   107:     eor #E
00:8076 8D0160          	   108:     sta PORTA
00:8079 60              	   109:     rts
                        	   110: 
                        	   111: display_hex_nibble: ; A->()
00:807A AA              	   112:     tax
00:807B BD8280          	   113:     lda .hex_chars, x
00:807E 206480          	   114:     jsr lcd_emitChar
00:8081 60              	   115:     rts
                        	   116: .hex_chars:
00:8082 3031323334353637	   117:     ascii "0123456789abcdef"
00:808A 3839616263646566
