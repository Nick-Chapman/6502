                        	   222: ;;     sec
                        	   223: ;;     sbc LAST_LED_TOGGLE
                        	   224: ;;     cmp #50
                        	   225: ;;     bne .done
                        	   226: ;;     lda JIFFY
                        	   227: ;;     sta LAST_LED_TOGGLE
                        	   228: ;;     jsr toggle_led
                        	   229: ;; .done:
                        	   230: ;;     rts
                        	   231: 
                        	   232: ;; toggle_led:
                        	   233: ;;     lda PORTA
                        	   234: ;;     eor #%1
                        	   235: ;;     sta PORTA
                        	   236: ;;     rts
                        	   237: 
                        	   238: irq:
00:8122 48              	   239:     pha
00:8123 2C0D60          	   240:     bit IFR
00:8126 7003            	   241:     bvs .timer1
                        	   242:     ;;lda IFR
                        	   243:     ;;ror
                        	   244:     ;;bcs .ca2
                        	   245:     ;;ror
                        	   246:     ;;bcs .ca1
                        	   247:     ;; IRQ fired; but IFR has 0s for ca1/2. how possible?
                        	   248:     ;; do nothing
00:8128 4C3281          	   249:     jmp .done
                        	   250: .timer1:
00:812B E614            	   251:     inc JIFFY
00:812D A940            	   252:     lda #%01000000
00:812F 8D0D60          	   253:     sta IFR
                        	   254:     ;;jmp .done
                        	   255: ;; .ca1:
                        	   256: ;;     inc COUNTER+1
                        	   257: ;;     lda #%00000010
                        	   258: ;;     sta IFR
                        	   259: ;;     jmp .done
                        	   260: ;; .ca2:
                        	   261: ;;     inc COUNTER+2
                        	   262: ;;     lda #%00000001
                        	   263: ;;     sta IFR
                        	   264: ;;     jmp .done
                        	   265: .done:
00:8132 68              	   266:     pla
