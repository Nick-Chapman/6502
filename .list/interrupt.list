                        	   162: display_counter:
00:80CB 20AF80          	   163:     jsr inc_counter
00:80CE A902            	   164:     lda #LCD_ReturnHome
00:80D0 204E80          	   165:     jsr lcd_instruction
00:80D3 A51C            	   166:     lda BCOUNTER+2
00:80D5 209280          	   167:     jsr display_hex_byte
00:80D8 A51B            	   168:     lda BCOUNTER+1
00:80DA 209280          	   169:     jsr display_hex_byte
00:80DD A51A            	   170:     lda BCOUNTER
00:80DF 209280          	   171:     jsr display_hex_byte
00:80E2 60              	   172:     rts
                        	   173: 
                        	   174: replace_counter: ; A-->B
00:80E3 A517            	   175:     lda ACOUNTER
00:80E5 851A            	   176:     sta BCOUNTER
00:80E7 A518            	   177:     lda ACOUNTER+1
00:80E9 851B            	   178:     sta BCOUNTER+1
00:80EB A519            	   179:     lda ACOUNTER+2
00:80ED 851C            	   180:     sta BCOUNTER+2
00:80EF 60              	   181:     rts
                        	   182: 
                        	   183: ;;; Timer interrupts. Every 1/100s (jiffy)
                        	   184: ;;; main loop (A) display counter (B) action synced to the second
                        	   185: ;;; Display counter counts how often in is called.
                        	   186: ;;; That counter is saved on each second. That is the value displayed
                        	   187: ;;; Also we display in decimal.
                        	   188: 
                        	   189: reset:
00:80F0 200080          	   190:     jsr via_init
00:80F3 202280          	   191:     jsr lcd_init
00:80F6 6414            	   192:     stz JIFFY
00:80F8 6415            	   193:     stz LAST_TICK
00:80FA 6416            	   194:     stz LAST_LED_TOGGLE
00:80FC 20A180          	   195:     jsr init_counterA
00:80FF 20A880          	   196:     jsr init_counterB
00:8102 58              	   197:     cli ; enable IRQ
                        	   198: .loop:
00:8103 20CB80          	   199:     jsr display_counter
00:8106 200C81          	   200:     jsr tick_counter_every_second
                        	   201:     ;;jsr toggle_led_25ms
00:8109 4C0381          	   202:     jmp .loop
                        	   203: 
                        	   204: tick_counter_every_second:
00:810C A514            	   205:     lda JIFFY
00:810E 38              	   206:     sec
00:810F E515            	   207:     sbc LAST_TICK
00:8111 C964            	   208:     cmp #100
00:8113 B002            	   209:     bcs .not_done ; hack for miss
00:8115 D00A            	   210:     bne .done
                        	   211: .not_done:
00:8117 A514            	   212:     lda JIFFY
00:8119 8515            	   213:     sta LAST_TICK
                        	   214:     ;;jsr inc_counter
00:811B 20E380          	   215:     jsr replace_counter
00:811E 20A180          	   216:     jsr init_counterA
                        	   217: .done:
00:8121 60              	   218:     rts
