                        	   119: display_hex_byte: ; A->()
00:8092 48              	   120:     pha
00:8093 4A              	   121:     lsr
00:8094 4A              	   122:     lsr
00:8095 4A              	   123:     lsr
00:8096 4A              	   124:     lsr
00:8097 207A80          	   125:     jsr display_hex_nibble
00:809A 68              	   126:     pla
00:809B 290F            	   127:     and #$f
00:809D 207A80          	   128:     jsr display_hex_nibble
00:80A0 60              	   129:     rts
